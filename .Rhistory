require(SingleCellExperiment)
sce <- readRDS('data/rnaSCE.rds')
table(sce$broad_celltype[sce$new_celltype %in% c('AT1','AT2')])
# all "Distal epithelial"
sce <- sce[, which(sce$broad_celltype == 'Distal epithelial')]
reducedDim(sce, 'X_pca') <- NULL
reducedDim(sce, 'X_umap') <- NULL
reducedDim(sce, 'X_umap_original') <- NULL
sce$celltype <- as.character(sce$new_celltype)
# 2000 most variable
rv <- rowVars(assay(sce,'logcounts'))
keep <- which(rv >= sort(rv, decreasing = TRUE)[2000])
require(BiocSingular)
pca <- runPCA(t(assay(sce,'logcounts')[keep,]), rank = 50)
reducedDim(sce,'pca') <- pca$x
require(uwot)
umap <- umap(reducedDim(sce,'PCA'))
umap <- umap(reducedDim(sce,'pca'))
reducedDim(sce,'umap') <- umap
require(batchelor)
sce2 <- fastMNN(sce, batch = sce$dissection, subset.row = keep)
reducedDim(sce,'fmnn') <- reducedDim(sce2,'corrected')
rm(sce2)
umap2 <- umap(reducedDim(sce,'fmnn'))
reducedDim(sce,'umap2') <- umap2
require(cluster)
dim.range <- c(5,10,15,20,30,40,50)
k.range <- c(3,4,5,6,7,8)
clusMat <- NULL
for(ndim in dim.range){
for(k in k.range){
clusMat <- cbind(clusMat,
pam(reducedDim(sce,'fmnn')[,1:ndim], k = k)$clustering)
}
}
consens <- apply(clusMat,1,function(x){
apply(clusMat,1,function(y){
mean(x == y)
})
})
hc <- hclust(as.dist(1-consens))
hc$order
consens.sort <- consens[hc$order, hc$order]
image(consens.sort)
plot(hc)
class(hc)
?plot.hclust
plot(hc, labels=FALSE)
memb <- cutree(hc, k = 6)
memb
plot(hc, labels=FALSE, col=colorby(memb))
plot(hc, labels='o', col=colorby(memb))
plot(hc, labels=rep('o',nrow(consens)), col=colorby(memb))
plot(umap2, asp=1, col = colorby(as.character(memb)))
